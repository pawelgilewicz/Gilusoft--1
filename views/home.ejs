    <link rel="stylesheet" href="home.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="icon" type="https://gilusoft-1-1.onrender.com/images/logo.png" href="/logo.png">
    <title>Gilusoft - Welcome</title>
</head>
<body>
    
    <div class="welcome-container">
        <h1 class="main-title">Gilusoft</h1>
        <hr class="title-divider">
        
        <div class="auth-buttons-group">
            <a class="btn-hero btn-register" href="/register" role="button">Register</a>
            <a class="btn-hero btn-login" href="/login" role="button">Login</a>
        </div>
    </div>

</body>
</html>
