<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="login.css">
    <link rel="icon" type="image/png" href="https://gilusoft-1-1.onrender.com/images/logo.png">
    <title>Login - Gilusoft</title>
</head>
<body>

    <div class="login-wrapper">
        <h1 id="login-title">Login</h1>

        <div class="login-row">
            <!-- Left Column: Standard Login -->
            <div class="login-col method-local">
                <div class="login-card">
                    <div class="login-card-body">
                        <form action="/login" method="POST" class="auth-form">
                            <div class="form-group">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" id="email" class="form-control" name="username" required>
                            </div>
                            <div class="form-group">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" id="password" class="form-control" name="password" required>
                            </div>
                            <button type="submit" class="btn btn-submit">Login</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Column: Google Login -->
            <div class="login-col method-google">
                <div class="google-logo-wrapper">
                    <img src="https://logosmarcas.net/wp-content/uploads/2020/09/Google-Emblema.png" alt="google-logo" class="google-badge-img">
                </div>
                
                <div class="login-card">
                    <div class="login-card-body">
                        <div class="google-btn-container">
                            <a class="google-link" href="/auth/google" role="button">
                                Sign In with Google
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</body>
</html>
