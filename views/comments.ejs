<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Bungee&family=Caveat:wght@400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Italiana&family=Oswald:wght@200..700&family=Playwrite+NZ+Basic:wght@100..400&family=Pliant:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="Comments.css">
</head>

<body>
   <header class="main-header">
    <div class="header-nav-left">
        <a class="back-link" href="/default">Back</a>
    </div>
    
    <h1 class="header-title">Our Comments</h1>
    
    <div class="header-nav-right">
        <a class="back-link" href="/addComment">Add Comment</a>
    </div>
</header>

    <main>

        <!-- <div class="container"> -->
        <% listaKomentarzy.forEach(post=> { %>

            <div class="review-card">
                <div class="review-header">
                    <div class="review-meta">
                        <span class="review-author">
                            <%= post.author_name %>
                        </span>
                        <span class="review-date">
                            <%= post.date %>
                        </span>
                    </div>

                    <div class="review-rating" aria-label="Rating: <%= post.rating %> out of 5">
                        <% for (let i=1; i <=5; i++) { %>
                            <span class="rating-star <%= i <= post.rating ? 'star-filled' : 'star-empty' %>">
                                <%= i <=post.rating ? '★' : '☆' %>
                            </span>
                            <% } %>
                    </div>
                </div>

                <h4 class="review-title">
                    <%= post.title %>
                </h4>

                <textarea readonly class="review-content"><%= post.content %></textarea>
            </div>

            <% }) %>

                <!-- </div> -->


    </main>
    <footer>
       
    </footer>

</body>

</html>