        <div class="form-container">
    <h2 class="form-main-title">Add Your Review</h2>

    <form action="/addcomment" method="POST" class="review-form">
        
        <!-- Rating Section -->
        <div class="form-group">
            <label class="form-label">Your Rating</label>
            <div class="stars-picker-container">
                <input type="radio" id="star5" name="rating" value="5" required>
                <label for="star5" class="picker-star">★</label>

                <input type="radio" id="star4" name="rating" value="4">
                <label for="star4" class="picker-star">★</label>

                <input type="radio" id="star3" name="rating" value="3">
                <label for="star3" class="picker-star">★</label>

                <input type="radio" id="star2" name="rating" value="2">
                <label for="star2" class="picker-star">★</label>

                <input type="radio" id="star1" name="rating" value="1">
                <label for="star1" class="picker-star">★</label>
            </div>
        </div>

        <!-- Title Section -->
        <div class="form-group">
            <label for="title" class="form-label">Review Title</label>
            <input type="text" id="title" name="title" class="form-input" required placeholder="e.g., Excellent quality and fast shipping!">
        </div>

        <!-- Content Section -->
        <div class="form-group">
            <label for="content" class="form-label">Review Content</label>
            <textarea id="content" name="content" class="form-textarea" required placeholder="Write your detailed experience here..."></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="form-submit-btn">Submit Review</button>
    </form>
</div>

    </main>
